# Ambiente Node/Next. Solitamente impostato dal runtime (es. `next dev`
# imposta development, `next build` build). Tienilo qui per il sync-check
# con src/lib/env.ts; lasciato vuoto, il default e' "development".
NODE_ENV=

# Livello del logger (pino). Vuoto = default per ambiente: debug in dev,
# info in production, warn in test. Override per debugging puntuale.
# Valori: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=

# Postgres (consumato da docker-compose.yml e dall'app)
POSTGRES_DB=sherdan_dm
POSTGRES_USER=sherdan
POSTGRES_PASSWORD=sherdan_dev
POSTGRES_PORT=5432

# URL completa che l'app usera' per connettersi.
# Tieni allineata con le quattro variabili sopra.
DATABASE_URL=postgresql://sherdan:sherdan_dev@localhost:5432/sherdan_dm

# LLM provider primario per chat/structured/stream. Gli embedding usano
# SEMPRE Ollama (decisione: stabilita' del vector space).
#   - gemini: usa Google AI Studio (free tier ok, vedi GOOGLE_AI_API_KEY)
#             con fallback automatico a Ollama su errori 5xx/429/network.
#   - ollama: solo locale, niente cloud.
LLM_PROVIDER=gemini

# Gemini (richiesto se LLM_PROVIDER=gemini). Ottieni una API key gratuita su
# https://ai.google.dev . Tieni il progetto Google Cloud SENZA billing per
# evitare addebiti automatici quando superi la quota free.
#
# Modelli su free tier (verificati 2026-05): tutti i Flash. I Pro
# (gemini-2.5-pro, gemini-3-pro-preview, gemini-3.1-pro-preview, alias
# gemini-pro-latest) hanno quota free = 0: usabili solo con billing
# abilitato. Default consigliato: gemini-3-flash-preview (Flash piu'
# recente, qualita' superiore a 2.5-flash). Alternative free: gemini-2.5-flash
# (stable), gemini-3.1-flash-lite-preview (piu' veloce, qualita' inferiore).
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Ollama locale. Avvia il servizio prima di usare i tool LLM.
# Modelli suggeriti per i7-12700H + 16 GB RAM + RTX 3050 (4 GB VRAM):
#   - qwen2.5:7b-instruct-q4_K_M  (~4.7 GB, italiano decente, fallback chat)
#   - mxbai-embed-large           (~670 MB, 1024-dim, embedding sempre)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=mxbai-embed-large

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
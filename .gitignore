# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Sherdan raw campaign sources contain GM-only secrets.
# Keep the directory structure and docs, but do not commit local campaign markdown.
/content/sherdan/*.md
!/content/sherdan/README.md
!/content/sherdan/.gitkeep

# export di conversazioni Claude Code (puo' contenere API key, prompt
# privati, lore della campagna). Mai committare.
conversation-export*.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
